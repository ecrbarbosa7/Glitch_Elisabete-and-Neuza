d":"5421022518238566493","type":"story_pin_image_block"}],"layout":0,"style":{"background_color":"#021D04"},"id":"3640959377","music_attributions":[],"should_mute":false}],"static_page_count":1,"type":"storypindata","metadata":{"root_pin_id":"730920214561649292","is_compatible":false,"is_promotable":true,"is_editable":false,"compatible_version":"0.16.0","version":"0.16.0","canvas_aspect_ratio":1,"pin_title":"escape the matrix","root_user_id":"730920351932135945","pin_image_signature":"5f492e0ab2136353946f046d11bc4798"},"pages":[{"image_signature_adjusted":"5f492e0ab2136353946f046d11bc4798","image_signature":"5f492e0ab2136353946f046d11bc4798","type":"storypinpage","blocks":[{"text":"","block_style":{"width":100,"corner_radius":0,"y_coord":0,"x_coord":0,"height":100,"rotation":0},"image_signature":"5f492e0ab2136353946f046d11bc4798","block_type":2,"tracking_id":"5421022518238566493","type":"story_pin_image_block"}],"layout":0,"style":{"background_color":"#021D04"},"id":"3640959377","music_attributions":[],"should_mute":false}],"page_count":1,"id":"5421022665949377023","has_affiliate_products":false},"created_at":"Tue, 14 Apr 2026 04:08:14 +0000","reaction_counts":{"1":1},"aggregated_pin_data":{"node_id":"QWdncmVnYXRlZFBpbkRhdGE6NTQyMTAyMjY2NDU4NDEyNTk4NQ==","has_xy_tags":false},"id":"352758583335009584","is_eligible_for_pre_loved_goods_label":false,"is_oos_product":false,"is_uploaded":true,"ad_match_reason":0,"did_its":[],"dominant_color":"#020604","is_downstream_promotion":false,"shopping_flags":[],"description":"Elena always felt something was off. The same people, same conversations, same patterns. One night, she saw it—a door standing alone on the sidewalk.  No one else noticed.  As she stepped closer, a whisper came: “You found it. Step through before they reset you.”  She turned—a man in a brown coat stared at her. He had passed her every morning, never once looking. Until now.  Heart racing, she shoved the door open.  Darkness. Then—a vast white space filled with screens. Her life, looping.  A woman appeared. \"This world isn’t real. Stay, or wake up. Choose.\"  Elena looked at the screen of her old life—safe but scripted.  She turned away.  And walked into the unknown.","link_utm_applicable_and_replaced":1},"16114511162305462":{"node_id":"UGluOjE2MTE0NTExMTYyMzA1NDYy","is_stale_product":false,"should_open_in_stream":false,"promoted_is_removable":false,"is_eligible_for_related_products":false,"is_promoted":false,"title":"","board":{"node_id":"Qm9hcmQ6MTYxMTQ1Nzk4NTYxMTExMTg=","name":"Hyperion Cantos","url":"/joaok1905/hyperion-cantos/","is_collaborative":false,"images":{"170x":[{"url":"https://i.pinimg.com/170x/07/83/06/078306a34284e948fd55f328e8abcc84.jpg","width":170,"height":131,"dominant_color":"#313935"},{"url":"https://i.pinimg.com/170x/5c/a3/ce/5ca3ce555c0260a1e8af06ac8fb26dce.jpg","width":170,"height":297,"dominant_color":"#333227"},{"url":"https://i.pinimg.com/170x/1e/e1/c1/1ee1c193d24a6affe3b3579a6f23ff06.jpg","width":170,"height":200,"dominant_color":"#131B1A"},{"url":"https://i.pinimg.com/170x/60/49/0e/60490e06c4951e7e94e6432692aebe2d.jpg","width":170,"height":248,"dominant_color":"#303239"},{"url":"https://i.pinimg.com/170x/cd/bb/68/cdbb68305b225f04bd214f6cc0b93b21.jpg","width":170,"height":169,"dominant_color":"#969EAF"},{"url":"https://i.pinimg.com/170x/f0/67/2a/f0672a2f84bdf2fcf69e8fb9552a8dd0.jpg","width":170,"height":232,"dominant_color":"#171A1C"},{"url":"https://i.pinimg.com/170x/38/e4/7a/38e47a2cc4e5724fe496574a76af8b59.jpg","width":170,"height":193,"dominant_color":"#25232A"},{"url":"https://i.pinimg.com/170x/4f/23/63/4f236389820b2d101eca0025ee61046f.jpg","width":170,"height":283,"dominant_color":"#574E4F"},{"url":"https://i.pinimg.com/170x/b9/38/f4/b938f46f7b0113d45b0764ef5235fc83.jpg","width":170,"height":212,"dominant_color":"#2A2E31"},{"url":"https://i.pinimg.com/170x/69/94/0a/69940a3df1af28028a334f105f33961b.jpg","width":170,"height":636,"dominant_color":"#69665C"}]},"image_cover_hd_url":"https:/